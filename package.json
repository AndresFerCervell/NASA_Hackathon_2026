{
  "name": "nasa_hackathon_2026",
  "version": "1.0.0",
  "private": true,
  "description": "Lunar Landing Site Navigator — 3D Sun-Earth-Moon Orbital Simulator",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "node -e \"const fs=require('fs'),cp=require('child_process');const py=['backend/.venv/Scripts/python.exe','backend/.venv/bin/python'].find(p=>fs.existsSync(p))||'python';cp.spawn(py,['-m','uvicorn','app.main:app','--app-dir','backend','--host','0.0.0.0','--port','3001','--reload'],{stdio:'inherit'}).on('exit',c=>process.exit(c??0))\"",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "python -m compileall -q backend/app backend/evaluar.py",
    "evaluate": "python backend/evaluar.py",
    "test:backend": "cd backend && python -B -m unittest discover -s tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndresFerCervell/NASA_Hackathon_2026.git"
  },
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
