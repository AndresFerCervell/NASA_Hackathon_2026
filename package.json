{
  "name": "nasa_hackathon_2026",
  "version": "1.0.0",
  "private": true,
  "description": "Lunar Landing Site Navigator — 3D Sun-Earth-Moon Orbital Simulator",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 3001 --reload",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "backend\\.venv\\Scripts\\python.exe -m py_compile backend/app/main.py backend/app/astronomy/ephemeris.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndresFerCervell/NASA_Hackathon_2026.git"
  },
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
